{
  "name": "@airewards/browser-extension",
  "version": "1.0.0",
  "description": "Official Chrome, Brave, and Edge browser extension for AIRewards.",
  "scripts": {
    "build": "NODE_ENV=production node build.mjs",
    "dev": "node build.mjs --watch",
    "package": "NODE_ENV=production node build.mjs && node package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/airewards/browser-extension"
  },
  "bugs": {
    "url": "https://github.com/airewards/browser-extension/issues"
  },
  "homepage": "https://www.airewards.tech",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "esbuild": "^0.19.12",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  }
}
